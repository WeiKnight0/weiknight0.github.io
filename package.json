{
  "name": "wkn-personal-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "frontend",
    "notes/reader",
    "notes/algorithm-templates"
  ],
  "scripts": {
    "dev": "npm run build && npm run preview",
    "dev:site": "npm run dev --workspace frontend",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "check": "npm run build-types --workspace frontend && npm test",
    "test": "node --test scripts/*.test.mjs && npm test --workspace notes/reader",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "parse5": "^7.3.0",
    "yaml": "^2.7.1"
  }
}
