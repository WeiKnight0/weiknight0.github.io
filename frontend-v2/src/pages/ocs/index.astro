---
import { getCollection } from 'astro:content';
import FictionPage from '@/templates/FictionPage.astro';

const characters = (await getCollection('ocs'))
  .filter((entry) => !entry.data.draft)
  .sort((left, right) => left.data.order - right.data.order);
---

<FictionPage
  title='Original Characters | My Homepage'
  description='Original character overview.'
>
  <section class='mx-auto max-w-7xl px-5 py-24 lg:px-8'>
    <p data-page-i18n='oc.kicker' class='mb-4 border-l-2 border-fiction-accent pl-4 font-real-mono text-xs font-black uppercase tracking-[0.28em] md:text-sm text-fiction-accent'>
      Original characters
    </p>
    <h1 data-page-i18n='oc.heading' class='font-fiction-serif text-5xl font-black leading-none tracking-wide text-fiction-text md:text-7xl drop-shadow-[0_2px_10px_rgba(0,0,0,0.75)]'>
      Original Characters
    </h1>
    <div class='mt-14 grid gap-5'>
      {characters.length === 0 ? (
        <p data-page-i18n='oc.empty' class='text-fiction-text/60'>No original characters yet.</p>
      ) : characters.map(({ id, data }) => (
        <a href={`/ocs/${encodeURIComponent(id)}/`} class='group border border-fiction-accent/25 bg-fiction-surface/80 p-7 transition hover:border-fiction-accent/60 hover:bg-fiction-accent/10'>
          <h2 class='font-fiction-serif text-3xl font-black text-fiction-text transition group-hover:text-fiction-accent'>{data.title}</h2>
          <p class='mt-4 font-fiction-serif text-base leading-7 text-fiction-text/75'>{data.description}</p>
        </a>
      ))}
    </div>
  </section>
</FictionPage>
