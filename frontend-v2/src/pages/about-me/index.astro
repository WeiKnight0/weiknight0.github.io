---
import { sitePath } from '@/utils/paths.mjs';
import Base from '@/templates/Base.astro';
import { Profile } from '@/utils/Profile';
const location = 'Nanjing, China';
const school = 'Southeast University';
---

<Base head={{ title: 'About me | WeiKnight', description: 'Meet WeiKnight, a computer science student interested in systems, software, and original worlds.' }} theme='real'>
  <main class='mx-auto w-full max-w-6xl px-5 py-14 text-real-text sm:py-20'>
    <section class='grid items-center gap-10 border-b border-white/10 pb-14 md:grid-cols-[minmax(0,1fr)_15rem] md:gap-16 md:pb-20'>
      <div>
        <p class='text-xs font-bold uppercase tracking-[.2em] text-real-accent'>A little about me</p>
        <h1 class='mt-4 text-5xl font-black tracking-[-.06em] md:text-7xl'>WeiKnight<span class='text-real-accent'>.</span></h1>
        <p class='mt-6 max-w-3xl text-xl leading-relaxed text-white/80 md:text-2xl'>I study how software works — from systems underneath to the things people build with them.</p>
        <p class='mt-5 max-w-2xl leading-7 text-white/60'>I’m a computer science student at {school}, based in {location}. I enjoy learning by taking ideas apart, writing them down, and turning them into useful projects.</p>
        <div class='mt-8 flex flex-wrap gap-3'>
          <a class='border border-real-accent/40 bg-real-accent px-5 py-3 text-sm font-bold text-black transition hover:brightness-110' href='mailto:weiknight0@outlook.com'>Get in touch</a>
          <a class='border border-white/15 px-5 py-3 text-sm font-bold text-white/75 transition hover:border-real-accent/40 hover:text-real-accent' href={Profile.github} target='_blank' rel='noopener noreferrer'>GitHub ↗</a>
        </div>
      </div>
      <img src={Profile.avatar} alt={`${Profile.handle} avatar`} class='mx-auto h-52 w-52 rounded-2xl object-cover md:h-60 md:w-60' />
    </section>

    <section class='grid gap-10 border-b border-white/10 py-12 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-16 md:py-16'>
      <h2 class='text-xs font-bold uppercase tracking-[.2em] text-real-accent'>What I’m into</h2>
      <div class='grid gap-8 sm:grid-cols-2'>
        <article>
          <h3 class='text-xl font-bold'>Systems &amp; software</h3>
          <p class='mt-3 leading-7 text-white/60'>I’m drawn to the layers beneath an application: how a program runs, how data moves, and how thoughtful engineering makes software reliable.</p>
          <p class='mt-4 text-sm font-semibold text-white/75'>{Profile.techStack.join(' · ')}</p>
        </article>
        <article>
          <h3 class='text-xl font-bold'>Original worlds</h3>
          <p class='mt-3 leading-7 text-white/60'>I also create original characters and build the worlds around them, exploring how their rules, histories, and relationships fit together.</p>
          <a href={sitePath("/worldbuilding/")} class='mt-4 inline-flex text-sm font-bold text-real-accent hover:underline'>Explore the archive ↗</a>
        </article>
      </div>
    </section>

    <section class='grid gap-6 py-12 sm:grid-cols-3 md:py-16'>
      <div><p class='text-xs font-bold uppercase tracking-[.16em] text-white/40'>Based in</p><p class='mt-2 font-semibold'>{location}</p></div>
      <div><p class='text-xs font-bold uppercase tracking-[.16em] text-white/40'>Studying</p><p class='mt-2 font-semibold'>Computer science · {school}</p></div>
      <div><p class='text-xs font-bold uppercase tracking-[.16em] text-white/40'>Elsewhere</p><a class='mt-2 inline-block font-semibold text-real-accent hover:underline' href={Profile.github} target='_blank' rel='noopener noreferrer'>GitHub ↗</a></div>
    </section>
  </main>
</Base>
