---
import { sitePath } from '@/utils/paths.mjs';
import Base from '@/templates/Base.astro';
import { Profile } from '@/utils/Profile';
const location = '中国江苏省南京市';
const school = '东南大学';
---

<Base head={{ title: '关于我 | WeiKnight', description: '认识 WeiKnight：关注系统、软件与原创世界的计算机专业学生。' }} theme='real' locale='zh-cn'>
  <main class='mx-auto w-full max-w-6xl px-5 py-14 text-real-text sm:py-20'>
    <section class='grid items-center gap-10 border-b border-white/10 pb-14 md:grid-cols-[minmax(0,1fr)_15rem] md:gap-16 md:pb-20'>
      <div>
        <p class='text-xs font-bold uppercase tracking-[.2em] text-real-accent'>关于我</p>
        <h1 class='mt-4 text-5xl font-black tracking-[-.06em] md:text-7xl'>WeiKnight<span class='text-real-accent'>.</span></h1>
        <p class='mt-6 max-w-3xl text-xl leading-relaxed text-white/80 md:text-2xl'>我喜欢理解软件如何运作——从底层系统，到人们用软件创造的事物。</p>
        <p class='mt-5 max-w-2xl leading-7 text-white/60'>我在{school}学习计算机科学，目前生活在{location}。我喜欢拆解想法、记录所学，再把它们做成真正有用的项目。</p>
        <div class='mt-8 flex flex-wrap gap-3'>
          <a class='border border-real-accent/40 bg-real-accent px-5 py-3 text-sm font-bold text-black transition hover:brightness-110' href='mailto:weiknight0@outlook.com'>联系我</a>
          <a class='border border-white/15 px-5 py-3 text-sm font-bold text-white/75 transition hover:border-real-accent/40 hover:text-real-accent' href={Profile.github} target='_blank' rel='noopener noreferrer'>GitHub ↗</a>
        </div>
      </div>
      <img src={Profile.avatar} alt={`${Profile.handle} avatar`} class='mx-auto h-52 w-52 rounded-2xl object-cover md:h-60 md:w-60' />
    </section>

    <section class='grid gap-10 border-b border-white/10 py-12 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-16 md:py-16'>
      <h2 class='text-xs font-bold uppercase tracking-[.2em] text-real-accent'>我关注的方向</h2>
      <div class='grid gap-8 sm:grid-cols-2'>
        <article>
          <h3 class='text-xl font-bold'>系统与软件</h3>
          <p class='mt-3 leading-7 text-white/60'>我对应用程序背后的层次很感兴趣：程序如何运行、数据如何流动，以及扎实的工程实践怎样让软件变得可靠。</p>
          <p class='mt-4 text-sm font-semibold text-white/75'>{Profile.techStack.join(' · ')}</p>
        </article>
        <article>
          <h3 class='text-xl font-bold'>原创世界</h3>
          <p class='mt-3 leading-7 text-white/60'>我也创作原创角色并构建他们生活的世界，整理其中的规则、历史与人物关系。</p>
          <a href={sitePath("/worldbuilding/zh-cn/")} class='mt-4 inline-flex text-sm font-bold text-real-accent hover:underline'>浏览设定档案 ↗</a>
        </article>
      </div>
    </section>

    <section class='grid gap-6 py-12 sm:grid-cols-3 md:py-16'>
      <div><p class='text-xs font-bold uppercase tracking-[.16em] text-white/40'>所在地</p><p class='mt-2 font-semibold'>{location}</p></div>
      <div><p class='text-xs font-bold uppercase tracking-[.16em] text-white/40'>学习方向</p><p class='mt-2 font-semibold'>计算机科学 · {school}</p></div>
      <div><p class='text-xs font-bold uppercase tracking-[.16em] text-white/40'>其他链接</p><a class='mt-2 inline-block font-semibold text-real-accent hover:underline' href={Profile.github} target='_blank' rel='noopener noreferrer'>GitHub ↗</a></div>
    </section>
  </main>
</Base>
