---
/**
 * @description Defines the stable heading and section navigation shared by every administration page.
 */
export interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  active: 'blogs' | 'users' | 'novels' | 'commissions' | 'oc' | 'security';
  viewHref?: string;
  viewLabel?: string;
}

const {
  eyebrow,
  title,
  description,
  active,
  viewHref,
  viewLabel,
} = Astro.props as Props;
const links = [
  { id: 'blogs', href: '/admin/blogs/', label: 'Edit blogs' },
  { id: 'novels', href: '/admin/novels/', label: 'Manage novels' },
  { id: 'oc', href: '/admin/oc/', label: 'Manage OCs' },
  { id: 'commissions', href: '/admin/commissions/', label: 'Manage commissions' },
  { id: 'users', href: '/admin/users/', label: 'Manage users' },
  { id: 'security', href: '/admin/security/', label: 'Security logs' },
] as const;
---

<header class='mb-6 border-b border-real-accent/30 pb-6'>
  <div class='flex flex-wrap items-start justify-between gap-5'>
    <div class='max-w-3xl'>
      <p class='text-xs font-bold uppercase tracking-[0.25em] text-real-accent'>{eyebrow}</p>
      <h1 class='mt-2 text-3xl font-black sm:text-4xl'>{title}</h1>
      {description && <p class='mt-2 text-sm text-white/45'>{description}</p>}
    </div>
    {viewHref && <div class='ml-auto flex min-h-9 flex-wrap justify-end gap-2 text-xs'>
      {viewHref && <a href={viewHref} target='_blank' class='border border-white/20 px-3 py-2 text-white/65 transition hover:border-real-accent/50 hover:text-real-accent'>{viewLabel} ↗</a>}
    </div>}
  </div>
  <nav class='mt-6 grid w-full grid-cols-2 text-sm sm:grid-cols-3 xl:grid-cols-6' aria-label='Administration sections'>
    {links.map((link) => (
      <a
        href={link.href}
        aria-current={link.id === active ? 'page' : undefined}
        class:list={[
          'border border-white/20 px-3 py-3 text-center transition',
          link.id === active
            ? 'border-real-accent/50 bg-real-accent/10 font-bold text-real-accent'
            : 'border-white/20 text-white/70 hover:border-real-accent/40 hover:text-real-accent',
        ]}
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>
