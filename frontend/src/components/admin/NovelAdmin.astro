---
import AdminHeader from './AdminHeader.astro';
---

<section data-novel-admin>
  <AdminHeader
    eyebrow='Fiction control'
    title='Manage novels'
    description='Create novels first, then add and edit their chapters.'
    active='novels'
    viewHref='/fiction/novels/'
    viewLabel='View novels'
  />
  <div id='novel-notice' class='mb-5 hidden border px-4 py-3 text-sm' role='status' aria-live='polite'></div>
  <div class='grid min-h-[44rem] overflow-hidden border border-white/10 bg-black/20 lg:grid-cols-[21rem_minmax(0,1fr)]'>
    <aside class='border-b border-white/10 bg-black/25 lg:border-b-0 lg:border-r'>
      <div class='border-b border-white/10 p-4'>
        <div class='flex items-center justify-between gap-3'>
          <div><h2 class='font-bold text-white'>Novels</h2><p id='novel-count' class='mt-1 text-xs text-white/40'>Loading…</p></div>
          <button id='novel-new' type='button' class='bg-real-accent px-3 py-2 text-sm font-black text-black'>+ New novel</button>
        </div>
        <input id='novel-search' type='search' placeholder='Search novels…' class='admin-input mt-4 w-full text-sm' />
      </div>
      <div id='novel-list' class='max-h-[calc(100vh-15rem)] overflow-y-auto p-2'></div>
    </aside>

    <section class='min-w-0'>
      <div id='novel-empty' class='grid min-h-[34rem] place-items-center p-8 text-center text-white/40'>Select a novel or create a new one.</div>
      <div id='novel-workspace' class='hidden'>
        <form id='novel-form' novalidate>
          <input type='hidden' name='id' />
          <header class='sticky top-0 z-20 flex flex-wrap items-center justify-between gap-3 border-b border-white/10 bg-real-bg/95 px-5 py-4 backdrop-blur'>
            <div><p id='novel-mode' class='text-xs font-bold uppercase tracking-[.2em] text-real-accent'></p><p class='mt-1 text-xs text-white/45'>Novel information</p></div>
            <div class='flex flex-wrap gap-2'>
              <button data-novel-move='up' hidden type='button' class='border border-white/20 px-4 py-2 text-sm text-white/70 disabled:opacity-30'>Move up ↑</button>
              <button data-novel-move='down' hidden type='button' class='border border-white/20 px-4 py-2 text-sm text-white/70 disabled:opacity-30'>Move down ↓</button>
              <a id='novel-preview' hidden target='_blank' class='border border-white/20 px-4 py-2 text-sm text-white/70'>Preview ↗</a>
              <button id='novel-delete' hidden type='button' class='border border-red-300/30 px-4 py-2 text-sm text-red-200'>Delete novel</button>
              <button id='novel-save' type='submit' class='bg-real-accent px-5 py-2 text-sm font-black text-black disabled:opacity-50'>Save novel</button>
            </div>
          </header>
          <div class='grid gap-5 p-5 sm:p-7'>
            <label class='grid gap-2'><span class='admin-label'>Title</span><input name='title' required maxlength='240' class='admin-input' /></label>
            <label id='novel-slug-field' hidden class='grid gap-2'><span class='admin-label'>URL</span><input name='slug' required disabled maxlength='160' pattern='[a-z0-9]+(?:-[a-z0-9]+)*' class='admin-input font-real-mono' /></label>
            <label class='grid gap-2'><span class='admin-label'>Description</span><textarea name='description' required maxlength='2000' rows='3' class='admin-input resize-y'></textarea></label>
          </div>
        </form>

        <section id='chapter-manager' hidden class='border-t border-white/10 p-5 sm:p-7'>
          <div class='flex flex-wrap items-center justify-between gap-3'>
            <div><h2 class='text-lg font-black text-white'>Chapters</h2><p id='chapter-count' class='mt-1 text-xs text-white/45'></p></div>
            <button id='chapter-new' type='button' class='border border-real-accent/40 px-3 py-2 text-sm text-real-accent'>+ New chapter</button>
          </div>
          <div class='mt-5 grid gap-6 xl:grid-cols-[18rem_minmax(0,1fr)]'>
            <div id='chapter-list' class='border border-white/10'></div>
            <div>
              <p id='chapter-empty' class='border border-dashed border-white/15 p-8 text-center text-sm text-white/40'>Select a chapter or create a new one.</p>
              <form id='chapter-form' hidden novalidate class='grid gap-4'>
                <input type='hidden' name='id' />
                <label class='grid gap-2'><span class='admin-label'>Chapter title</span><input name='title' required maxlength='240' class='admin-input' /></label>
                <label class='grid gap-2'><span class='admin-label'>Markdown content</span><textarea name='content' required rows='20' class='admin-input min-h-[28rem] resize-y font-real-mono leading-7'></textarea></label>
                <div class='flex gap-3'>
                  <button data-chapter-move='up' hidden type='button' class='border border-white/20 px-4 py-2 text-sm text-white/70 disabled:opacity-30'>Move up ↑</button>
                  <button data-chapter-move='down' hidden type='button' class='border border-white/20 px-4 py-2 text-sm text-white/70 disabled:opacity-30'>Move down ↓</button>
                  <button id='chapter-save' type='submit' class='bg-real-accent px-4 py-2 text-sm font-black text-black disabled:opacity-50'>Save chapter</button>
                  <button id='chapter-delete' hidden type='button' class='border border-red-300/30 px-4 py-2 text-sm text-red-200'>Delete chapter</button>
                </div>
              </form>
            </div>
          </div>
        </section>
      </div>
    </section>
  </div>
</section>

<script>
  import '@/scripts/novel-admin';
</script>

<style is:global>
  .admin-input { @apply border border-white/20 bg-black/30 p-3 text-white outline-none transition focus:border-real-accent; }
  .admin-label { @apply text-xs font-bold uppercase tracking-[0.16em] text-white/60; }
</style>
