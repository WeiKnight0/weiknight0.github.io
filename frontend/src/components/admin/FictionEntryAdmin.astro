---
import AdminHeader from './AdminHeader.astro';

/**
 * @description Configures the shared two-pane editor used by novels and original characters.
 */
export interface Props {
  kind: 'novels' | 'oc';
}

const { kind } = Astro.props as Props;
const config = kind === 'novels'
  ? {
      title: 'Manage novels',
      singular: 'Novel',
      description: 'Create, order, edit, and publish novels without rebuilding the site.',
    }
  : {
      title: 'Manage OCs',
      singular: 'OC',
      description: 'Maintain original-character summaries and Markdown profile pages.',
    };
const publicBase = `/fiction/${kind}`;
---

<section data-fiction-entry-admin data-kind={kind} data-singular={config.singular}>
  <AdminHeader
    eyebrow='Fiction control'
    title={config.title}
    description={config.description}
    active={kind}
    viewHref={`${publicBase}/`}
    viewLabel={`View ${kind === 'oc' ? 'OCs' : 'novels'}`}
  />
  <div id='fiction-notice' class='mb-5 hidden border px-4 py-3 text-sm' role='status' aria-live='polite'></div>
  <div class='grid min-h-[44rem] overflow-hidden border border-white/10 bg-black/20 lg:grid-cols-[21rem_minmax(0,1fr)]'>
    <aside class='border-b border-white/10 bg-black/25 lg:border-b-0 lg:border-r'>
      <div class='border-b border-white/10 p-4'>
        <div class='flex items-center justify-between gap-3'>
          <div><h2 class='font-bold text-white'>{config.title}</h2><p id='fiction-count' class='mt-1 text-xs text-white/40'>Loading…</p></div>
          <button id='fiction-new' type='button' class='bg-real-accent px-3 py-2 text-sm font-black text-black'>+ New</button>
        </div>
        <input id='fiction-search' type='search' placeholder={`Search ${kind === 'oc' ? 'OCs' : 'novels'}…`} class='admin-input mt-4 w-full text-sm' />
      </div>
      <div id='fiction-list' class='max-h-[calc(100vh-15rem)] overflow-y-auto p-2'></div>
    </aside>

    <section class='min-w-0'>
      <div id='fiction-empty' class='grid min-h-[34rem] place-items-center p-8 text-center text-white/40'>Select an entry or create a new {config.singular.toLowerCase()}.</div>
      <form id='fiction-form' class='hidden' novalidate>
        <input type='hidden' name='id' />
        <header class='sticky top-0 z-20 flex flex-wrap items-center justify-between gap-3 border-b border-white/10 bg-real-bg/95 px-5 py-4 backdrop-blur'>
          <div><p id='fiction-mode' class='text-xs font-bold uppercase tracking-[.2em] text-real-accent'></p><p id='fiction-save-state' class='mt-1 text-xs text-white/45'>No unsaved changes</p></div>
          <div class='flex flex-wrap gap-2'>
            {kind === 'oc' && <>
              <button data-fiction-move='up' hidden type='button' class='border border-white/20 px-4 py-2 text-sm text-white/70 disabled:opacity-30'>Move up ↑</button>
              <button data-fiction-move='down' hidden type='button' class='border border-white/20 px-4 py-2 text-sm text-white/70 disabled:opacity-30'>Move down ↓</button>
            </>}
            <a id='fiction-preview' hidden target='_blank' class='border border-white/20 px-4 py-2 text-sm text-white/70'>Preview ↗</a>
            <button id='fiction-delete' hidden type='button' class='border border-red-300/30 px-4 py-2 text-sm text-red-200'>Delete</button>
            <button id='fiction-save' type='submit' class='bg-real-accent px-5 py-2 text-sm font-black text-black disabled:opacity-50'>Save</button>
          </div>
        </header>
        <div class='grid gap-5 p-5 sm:p-7'>
          <div class='grid items-start gap-5 xl:grid-cols-2'>
            <label class='grid gap-2'><span class='admin-label'>Title</span><input name='title' required maxlength='240' class='admin-input' /></label>
            <label class='grid gap-2'><span class='admin-label'>URL slug</span><input name='slug' required maxlength='160' pattern='[a-z0-9]+(?:-[a-z0-9]+)*' class='admin-input' /></label>
          </div>
          <label class='grid gap-2'><span class='admin-label'>Description</span><textarea name='description' required maxlength='2000' rows='3' class='admin-input resize-y'></textarea></label>
          <div class='grid items-start gap-5 sm:grid-cols-2'>
            {kind === 'novels'
              ? <label class='grid gap-2'><span class='admin-label'>Display order</span><input name='displayOrder' required type='number' min='0' value='1000' class='admin-input' /></label>
              : <input name='displayOrder' type='hidden' value='1000' />}
            <label class='flex h-full items-center gap-3 border border-white/10 p-4 text-sm text-white/70'><input name='published' type='checkbox' class='h-4 w-4 accent-cyan-400' /><span>Visible to visitors</span></label>
          </div>
          <label class='grid gap-2'><span class='admin-label'>Markdown content</span><textarea name='content' required rows='24' class='admin-input min-h-[32rem] resize-y font-real-mono leading-7'></textarea></label>
        </div>
      </form>
    </section>
  </div>
</section>

<script>
  import '@/scripts/fiction-entry-admin';
</script>

<style is:global>
  .admin-input { @apply border border-white/20 bg-black/30 p-3 text-white outline-none transition focus:border-real-accent; }
  .admin-label { @apply text-xs font-bold uppercase tracking-[0.16em] text-white/60; }
</style>
