---
import Base from '@/templates/Base.astro';
---

<Base head={{ title: 'Personal Center | WeiKnight', description: 'Account information' }} theme='real'>
  <main class='mx-auto max-w-5xl px-5 py-14 font-formal-sans text-real-text md:py-20'>
    <section>
      <p class='text-xs font-bold uppercase tracking-[.2em] text-real-accent'>Account</p>
      <h1 class='mt-3 text-3xl font-black md:text-4xl'>Personal center</h1>
      <p class='mt-3 max-w-2xl text-sm leading-6 text-white/55'>Manage your public profile, avatar and account security from one place.</p>
      <p id='profile-loading' class='mt-9 text-white/70'>Loading account…</p>
      <div id='profile-content' class='mt-9 text-white/70' hidden>
        <div id='profile-message' hidden></div>
        <section class='border border-white/10 bg-real-surface p-6 md:p-8'>
          <div class='flex flex-col gap-6 sm:flex-row sm:items-center'>
            <div class='h-28 w-28 shrink-0'>
              <img id='profile-avatar-image' hidden class='h-full w-full rounded-full border border-real-accent/40 object-cover' />
              <span id='profile-avatar-fallback' class='grid h-full w-full place-items-center rounded-full border border-real-accent/40 bg-real-accent/10 text-3xl font-black text-real-accent'></span>
            </div>
            <div class='min-w-0 flex-1'>
              <div class='flex flex-wrap items-center gap-3'>
                <p id='profile-name' class='truncate text-2xl font-black text-white md:text-3xl'></p>
                <span id='profile-role' class='border border-real-accent/30 bg-real-accent/10 px-2.5 py-1 text-[.65rem] font-bold uppercase tracking-[.16em] text-real-accent'></span>
              </div>
              <p id='profile-username' class='mt-2 text-sm text-white/45'></p>
              <p id='profile-bio' class='mt-3 max-w-2xl text-sm leading-6 text-white/60'></p>
            </div>
            <div class='flex shrink-0 flex-wrap gap-2'>
              <button id='profile-avatar-upload' type='button' class='border border-white/20 px-3 py-2 text-sm text-white/70 transition hover:border-real-accent/50 hover:text-real-accent'>Upload avatar</button>
              <button id='profile-avatar-remove' type='button' class='border border-white/20 px-3 py-2 text-sm text-white/55 transition hover:border-red-300/40 hover:text-red-200'>Remove</button>
            </div>
            <input id='profile-avatar-file' type='file' accept='image/png,image/jpeg,image/webp' hidden />
          </div>
        </section>

        <div class='mt-6 grid items-start gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(17rem,.65fr)]'>
          <div class='grid gap-6'>
            <form id='profile-form' class='grid gap-5 border border-white/10 bg-real-surface p-6'>
              <div><h2 class='text-lg font-black text-white'>Public profile</h2><p class='mt-1 text-sm text-white/45'>Your username is fixed, but the visible profile is yours to maintain.</p></div>
              <label class='field-label grid gap-2'>Display name<input name='displayName' required maxlength='100' class='input' /></label>
              <label class='field-label grid gap-2'>About you<textarea name='bio' maxlength='500' rows='5' placeholder='A short introduction' class='input resize-y leading-6'></textarea><span class='text-right text-[.7rem] font-normal normal-case tracking-normal text-white/35'><span id='profile-bio-count'>0</span>/500</span></label>
              <button type='submit' class='bg-real-accent px-4 py-3 font-black text-black transition hover:brightness-110'>Save profile</button>
            </form>

            <form id='profile-password-form' class='grid gap-5 border border-white/10 bg-real-surface p-6'>
              <div><h2 class='text-lg font-black text-white'>Security</h2><p class='mt-1 text-sm text-white/45'>Use at least eight characters and confirm the replacement password.</p></div>
              <label class='field-label grid gap-2'>Current password<input name='currentPassword' required type='password' autocomplete='current-password' class='input' /></label>
              <div class='grid gap-4 md:grid-cols-2'>
                <label class='field-label grid gap-2'>New password<input name='password' required minlength='8' maxlength='200' type='password' autocomplete='new-password' class='input' /></label>
                <label class='field-label grid gap-2'>Confirm password<input name='passwordConfirmation' required minlength='8' maxlength='200' type='password' autocomplete='new-password' class='input' /></label>
              </div>
              <button type='submit' class='border border-real-accent/40 px-4 py-3 font-bold text-real-accent transition hover:bg-real-accent/10'>Change password</button>
            </form>
          </div>

          <aside class='grid gap-6'>
            <section class='border border-white/10 bg-real-surface p-6'>
              <h2 class='font-black text-white'>Account details</h2>
              <dl class='mt-5 grid gap-4 text-sm'>
                <div class='flex items-center justify-between gap-4 border-b border-white/10 pb-3'><dt class='text-white/45'>Account type</dt><dd id='profile-detail-role' class='font-bold text-white/80'></dd></div>
                <div class='flex items-center justify-between gap-4 border-b border-white/10 pb-3'><dt class='text-white/45'>Joined</dt><dd id='profile-created' class='text-right text-white/70'></dd></div>
                <div class='flex items-center justify-between gap-4'><dt class='text-white/45'>Last updated</dt><dd id='profile-updated' class='text-right text-white/70'></dd></div>
              </dl>
            </section>
            <section class='border border-white/10 bg-real-surface p-6'>
              <h2 class='font-black text-white'>Quick access</h2>
              <nav class='mt-4 grid gap-2'>
                <a id='profile-admin-link' href='/admin/blogs/' class='border border-real-accent/30 px-4 py-3 text-sm font-bold text-real-accent transition hover:bg-real-accent/10'>Administration panel <span class='float-right'>↗</span></a>
                <a href='/real/notes/' class='border border-white/10 px-4 py-3 text-sm text-white/65 transition hover:border-real-accent/30 hover:text-real-accent'>Browse notes <span class='float-right'>→</span></a>
                <a href='/real/blog/' class='border border-white/10 px-4 py-3 text-sm text-white/65 transition hover:border-real-accent/30 hover:text-real-accent'>Read blogs <span class='float-right'>→</span></a>
              </nav>
            </section>
            <button id='profile-logout' class='border border-white/20 px-4 py-3 text-sm font-bold text-white/65 transition hover:border-red-300/40 hover:text-red-200'>Sign out</button>
          </aside>
        </div>
      </div>
    </section>
  </main>
  <script>
    import '@/scripts/profile';
  </script>
  <style is:global>
    .input { @apply border border-white/20 bg-black/30 p-3 text-base font-normal normal-case tracking-normal text-white outline-none transition focus:border-real-accent; }
    .field-label { @apply text-xs font-bold uppercase tracking-[0.16em] text-white/60; }
  </style>
</Base>
