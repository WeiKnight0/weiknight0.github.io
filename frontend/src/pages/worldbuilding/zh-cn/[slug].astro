---
import { getCollection } from 'astro:content';

import WorldArticle from '@/partials/WorldArticle.astro';
import FictionPage from '@/templates/FictionPage.astro';

export async function getStaticPaths() {
  const items = (await getCollection('world')).filter((item) =>
    item.slug.startsWith('zh-cn/')
  );

  return items.map((item) => ({
    params: { slug: item.slug.split('/').at(-1) },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();
---

<FictionPage
  title={`${item.data.title} | 世界观 | 个人主页`}
  description={item.data.description}
  locale='zh-cn'
>
  <WorldArticle title={item.data.title} locale='zh-cn'>
    <Content />
  </WorldArticle>
</FictionPage>
