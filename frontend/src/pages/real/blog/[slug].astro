---
import { getCollection } from 'astro:content';

import RealPage from '@/templates/RealPage.astro';
import BlogPostClient from '@/partials/BlogPostClient.astro';
import '@/styles/blog-article.css';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const dateFormatter = new Intl.DateTimeFormat('en', { dateStyle: 'long' });
const description = post.data.description ?? post.data.title;
---

<RealPage
  title={`${post.data.title} | Blogs | My Homepage`}
  description={description}
>
  <article id='blog-article' data-has-initial='true' class='mx-auto max-w-6xl px-4 py-24 sm:px-6 lg:px-8'>
    <a href='/real/blog/' class='text-base font-bold text-cyan-300 transition hover:text-cyan-200'>
      ← Back to blogs
    </a>
    <p class='mt-10 text-base font-black uppercase tracking-[0.28em] text-cyan-300 md:text-lg'>
      Blogs
    </p>
    <h1 id='blog-title' class='mt-6 text-3xl font-black leading-tight tracking-[-0.035em] text-white md:text-5xl'>
      {post.data.title}
    </h1>
    <p id='blog-description' class='mt-6 text-lg leading-8 text-slate-300'>{description}</p>
    <div class='mt-8 flex flex-wrap items-center gap-3 text-base text-slate-400'>
      <time id='blog-date' datetime={post.data.date.toISOString()}>{dateFormatter.format(post.data.date)}</time>
      <span id='blog-tags' class='contents'>{post.data.tags.map((tag) => (
        <a
          href={`/real/blog/tags/${encodeURIComponent(tag)}/`}
          class='rounded-full border border-cyan-300/20 px-3 py-1 text-sm font-bold text-cyan-200 transition hover:bg-cyan-300/10'
        >
          {tag}
        </a>
      ))}</span>
    </div>
    <div id='blog-content' class='blog-prose prose prose-base prose-invert prose-slate mt-14 max-w-none prose-headings:font-black prose-a:text-cyan-300 prose-strong:text-white md:prose-lg'>
      <Content />
    </div>
  </article>
  <BlogPostClient />
</RealPage>
