---
import Base from '@/templates/Base.astro';
---

<Base head={{ title: 'Notes Admin | WeiKnight', description: 'Notes administration' }} theme='real'>
  <main class='mx-auto max-w-7xl px-5 py-12 font-real-mono text-real-text'>
    <header class='mb-6 flex flex-wrap items-center justify-between gap-4 border-b border-real-accent/30 pb-5'>
      <div>
        <p class='text-xs font-bold uppercase tracking-[0.25em] text-real-accent'>Content control</p>
        <h1 class='mt-2 text-3xl font-black'>Notes editor</h1>
      </div>
      <nav class='flex flex-wrap gap-3 text-sm'>
        <a href='/admin/' class='border border-white/20 px-4 py-2 text-white/70'>Blog editor</a>
        <a href='/admin/users/' class='border border-white/20 px-4 py-2 text-white/70'>Manage users</a>
      </nav>
    </header>

    <div class='grid gap-6 lg:grid-cols-[320px_1fr]'>
      <aside class='min-h-0 border border-white/10 bg-real-surface'>
        <section class='border-b border-white/10 p-4'>
          <div class='flex items-center justify-between gap-3'>
            <div>
              <h2 class='font-bold'>Markdown</h2>
              <p id='note-count' class='mt-1 text-xs text-white/40'>Loading…</p>
            </div>
            <button id='new-note' type='button' class='text-real-accent'>+ New</button>
          </div>
          <label class='mt-4 block'>
            <span class='sr-only'>Search Markdown files</span>
            <input id='note-search' type='search' placeholder='Search notes…' class='w-full border border-white/20 bg-black/30 p-2 text-sm text-white' />
          </label>
          <div id='tree' class='mt-5 grid max-h-[34rem] gap-2 overflow-y-auto text-sm'></div>
        </section>

        <section class='p-4'>
          <div class='flex items-center justify-between gap-3'>
            <div>
              <h2 class='font-bold'>Images</h2>
              <p id='image-count' class='mt-1 text-xs text-white/40'>0 images</p>
            </div>
            <button id='show-upload' type='button' class='text-real-accent'>+ Upload</button>
          </div>
          <label class='mt-4 block'>
            <span class='sr-only'>Search image files</span>
            <input id='image-search' type='search' placeholder='Search images…' class='w-full border border-white/20 bg-black/30 p-2 text-sm text-white' />
          </label>
          <form id='asset-form' class='mt-4 hidden grid gap-3'>
            <label class='grid gap-1 text-xs text-white/60'>Destination path
              <input name='path' required placeholder='assets/example.png' class='border border-white/20 bg-black/30 p-2 text-white' />
            </label>
            <label class='grid gap-1 text-xs text-white/60'>Image file
              <input name='file' required type='file' accept='.png,.jpg,.jpeg,.gif,.webp,image/png,image/jpeg,image/gif,image/webp' class='text-white/70' />
            </label>
            <div class='flex gap-2'>
              <button id='upload-asset' type='submit' class='bg-real-accent px-3 py-2 text-xs font-bold text-black'>Upload image</button>
              <button id='cancel-upload' type='button' class='border border-white/20 px-3 py-2 text-xs'>Cancel</button>
            </div>
          </form>
          <div id='images' class='mt-5 grid max-h-72 gap-2 overflow-y-auto text-sm'></div>
        </section>
      </aside>

      <section>
        <div class='mb-4 flex flex-wrap items-center justify-between gap-3'>
          <p id='path' class='text-real-accent'>Select a note</p>
          <button id='save' type='button' class='bg-real-accent px-4 py-2 font-bold text-black'>Save & Publish</button>
        </div>
        <textarea id='editor' class='min-h-[70vh] w-full border border-white/20 bg-black/30 p-5 font-mono text-sm text-white'></textarea>
        <p id='status' class='mt-3 text-xs text-white/50' role='status' aria-live='polite'></p>
      </section>
    </div>

    <dialog id='image-preview' class='w-[min(90vw,64rem)] border border-white/20 bg-real-bg p-0 text-real-text backdrop:bg-black/80'>
      <header class='flex items-center justify-between gap-4 border-b border-white/10 p-4'>
        <p id='image-path' class='min-w-0 truncate text-sm text-real-accent'></p>
        <button id='close-preview' type='button' class='border border-white/20 px-3 py-1 text-sm'>Close</button>
      </header>
      <div class='flex max-h-[75vh] items-center justify-center overflow-auto bg-black/40 p-5'>
        <img id='image-content' alt='Selected note image preview' class='max-h-[68vh] max-w-full object-contain' />
      </div>
    </dialog>
  </main>
  <script is:inline src='/js/api.js'></script>
  <script is:inline src='/js/notes-admin.js'></script>
</Base>
