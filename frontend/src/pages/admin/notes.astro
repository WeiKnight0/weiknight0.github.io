---
import Base from '@/templates/Base.astro';
---
<Base head={{ title: 'Notes Admin | WeiKnight', description: 'Notes administration' }} theme='real'>
  <main class='mx-auto grid max-w-7xl gap-6 px-5 py-12 font-real-mono text-real-text lg:grid-cols-[280px_1fr]'>
    <aside class='border border-white/10 bg-real-surface p-4'><div class='flex justify-between'><h1 class='font-bold'>NOTES</h1><button id='new-note' class='text-real-accent'>+ New</button></div><div id='tree' class='mt-5 grid gap-2 text-sm'></div></aside>
    <section><div class='mb-4 flex items-center justify-between'><p id='path' class='text-real-accent'>Select a note</p><button id='save' class='bg-real-accent px-4 py-2 font-bold text-black'>Save & Publish</button></div><textarea id='editor' class='min-h-[70vh] w-full border border-white/20 bg-black/30 p-5 font-mono text-sm text-white'></textarea><p id='status' class='mt-3 text-xs text-white/50'></p></section>
  </main>
  <script is:inline src='/js/notes-admin.js'></script>
</Base>
