---
import AdminHeader from '@/components/admin/AdminHeader.astro';
import Base from '@/templates/Base.astro';
---

<Base head={{ title: 'User Admin | WeiKnight', description: 'User administration' }} theme='real'>
  <main class='mx-auto w-full max-w-[110rem] px-4 py-10 font-formal-sans text-real-text sm:px-6 lg:px-8'>
    <AdminHeader eyebrow='Access control' title='User management' description='Only administrators can create or revoke accounts. Public registration remains disabled.' active='users' />
    <div data-user-admin class='mx-auto max-w-7xl'>
      <div id='notice' class='mb-5 hidden border px-4 py-3 text-sm' role='status' aria-live='polite'></div>

      <div class='grid gap-6 md:grid-cols-[18rem_minmax(0,1fr)] lg:grid-cols-[21rem_minmax(0,1fr)]'>
        <aside class='border border-white/10 bg-real-surface'>
          <div class='border-b border-white/10 p-4'>
            <div class='flex items-center justify-between gap-3'>
              <div><h2 class='font-bold text-white'>Member accounts</h2><p id='user-count' class='mt-1 text-xs text-white/40'>Loading…</p></div>
              <button id='new-user' type='button' class='bg-real-accent px-3 py-2 text-xs font-black text-black'>New user</button>
            </div>
            <input id='user-search' type='search' placeholder='Search users…' class='input mt-4 w-full text-sm' />
          </div>
          <div id='users-list' class='max-h-[42rem] divide-y divide-white/10 overflow-y-auto'></div>
        </aside>

        <section class='min-h-[34rem] border border-white/10 bg-real-surface'>
          <div id='editor-empty' class='grid min-h-[34rem] place-items-center p-8 text-center text-sm text-white/40'>Select an account or create a new user.</div>
          <div id='user-editor' hidden>
            <header class='flex flex-wrap items-center gap-5 border-b border-white/10 p-6'>
              <div id='editor-avatar' class='grid h-20 w-20 shrink-0 place-items-center overflow-hidden rounded-full border border-real-accent/40 bg-real-accent/10 text-2xl font-black text-real-accent'></div>
              <div class='min-w-0 flex-1'><p id='editor-mode' class='text-xs font-bold uppercase tracking-[.18em] text-real-accent'></p><h2 id='editor-title' class='mt-1 truncate text-2xl font-black text-white'></h2><p id='editor-meta' class='mt-1 text-xs text-white/40'></p></div>
              <div id='avatar-actions' hidden class='flex flex-wrap gap-2'>
                <button id='upload-avatar' type='button' class='border border-white/20 px-3 py-2 text-xs text-white/70'>Upload avatar</button>
                <button id='remove-avatar' type='button' class='border border-white/20 px-3 py-2 text-xs text-white/55'>Remove avatar</button>
              </div>
            </header>

            <div class='grid gap-8 p-6 xl:grid-cols-2'>
              <form id='account-form' class='grid content-start gap-4'>
                <h3 class='font-bold text-white'>Account details</h3>
                <label class='grid gap-2'><span class='field-label'>Username</span><input name='username' required minlength='3' maxlength='100' pattern='[A-Za-z0-9][A-Za-z0-9._-]*' autocomplete='off' class='input' /><span class='text-xs text-white/35'>Letters, numbers, dots, underscores, and hyphens.</span></label>
                <label class='grid gap-2'><span class='field-label'>Display name</span><input name='displayName' required maxlength='100' autocomplete='off' class='input' /></label>
                <label id='enabled-field' hidden class='flex items-center gap-3 border border-white/10 p-3 text-sm text-white/70'><input name='enabled' type='checkbox' class='h-4 w-4 accent-cyan-400' /><span>Account enabled</span></label>
                <button id='save-user' type='submit' class='bg-real-accent px-4 py-3 font-black text-black disabled:cursor-wait disabled:opacity-50'>Save account</button>
              </form>

              <div id='existing-user-actions' hidden class='grid content-start gap-6'>
                <form id='password-form' class='grid gap-4 border border-white/10 p-5'>
                  <div><h3 class='font-bold text-white'>Reset password</h3><p class='mt-1 text-xs text-white/35'>The member will use this password on their next login.</p></div>
                  <label class='grid gap-2'><span class='field-label'>New password</span><input name='password' required minlength='8' maxlength='200' type='password' autocomplete='new-password' class='input' /></label>
                  <label class='grid gap-2'><span class='field-label'>Confirm new password</span><input name='passwordConfirmation' required minlength='8' maxlength='200' type='password' autocomplete='new-password' class='input' /></label>
                  <button type='submit' class='border border-real-accent/40 px-4 py-3 font-bold text-real-accent'>Reset password</button>
                </form>
                <div class='border border-red-300/20 p-5'><h3 class='font-bold text-red-200'>Danger zone</h3><p class='mt-1 text-xs leading-5 text-white/35'>Deleting an account immediately revokes its active session and removes its avatar.</p><button id='delete-user' type='button' class='mt-4 border border-red-300/30 px-4 py-2 text-sm text-red-200'>Delete account</button></div>
              </div>
            </div>
            <input id='avatar-file' type='file' accept='image/png,image/jpeg,image/webp' hidden />
          </div>
        </section>
      </div>

      <dialog id='create-user-dialog' class='m-auto w-[calc(100%-2rem)] max-w-lg border border-real-accent/35 bg-real-bg p-0 text-real-text shadow-2xl'>
        <div class='flex items-start justify-between gap-5 border-b border-white/10 p-6'>
          <div><p class='text-xs font-bold uppercase tracking-[.18em] text-real-accent'>New member</p><h2 class='mt-1 text-2xl font-black text-white'>Create account</h2><p class='mt-2 text-sm text-white/40'>Public registration remains disabled.</p></div>
          <button id='close-create-user' type='button' class='grid h-9 w-9 shrink-0 place-items-center text-xl text-white/45 transition hover:bg-white/5 hover:text-white' aria-label='Close'>×</button>
        </div>
        <form id='create-user-form' class='grid gap-4 p-6'>
          <div id='create-user-error' hidden class='border border-red-300/30 bg-red-300/10 px-4 py-3 text-sm text-red-200'></div>
          <label class='grid gap-2'><span class='field-label'>Username</span><input name='username' required minlength='3' maxlength='100' pattern='[A-Za-z0-9][A-Za-z0-9._-]*' autocomplete='off' class='input' /><span class='text-xs text-white/35'>Letters, numbers, dots, underscores, and hyphens.</span></label>
          <label class='grid gap-2'><span class='field-label'>Display name</span><input name='displayName' required maxlength='100' autocomplete='off' class='input' /></label>
          <label class='grid gap-2'><span class='field-label'>Initial password</span><input name='password' required minlength='8' maxlength='200' type='password' autocomplete='new-password' class='input' /></label>
          <label class='grid gap-2'><span class='field-label'>Confirm initial password</span><input name='passwordConfirmation' required minlength='8' maxlength='200' type='password' autocomplete='new-password' class='input' /></label>
          <div class='mt-2 flex justify-end gap-3'>
            <button id='cancel-create-user' type='button' class='border border-white/20 px-4 py-3 text-sm text-white/65'>Cancel</button>
            <button id='create-user-submit' type='submit' class='bg-real-accent px-5 py-3 font-black text-black disabled:cursor-wait disabled:opacity-50'>Create user</button>
          </div>
        </form>
      </dialog>
    </div>
  </main>
  <script>
    import '@/scripts/users-admin';
  </script>
  <style is:global>
    .input { @apply border border-white/20 bg-black/30 p-3 text-white outline-none transition focus:border-real-accent; }
    .field-label { @apply text-xs font-bold uppercase tracking-[0.16em] text-white/60; }
    [data-user-admin] [hidden] { display: none !important; }
    #create-user-dialog::backdrop { background: rgb(0 0 0 / 0.72); backdrop-filter: blur(3px); }
  </style>
</Base>
