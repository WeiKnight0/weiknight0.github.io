---
import AdminHeader from '@/components/admin/AdminHeader.astro';
import Base from '@/templates/Base.astro';
---

<Base head={{ title: 'Commission Admin | WeiKnight', description: 'Commission image administration' }} theme='real'>
  <main class='mx-auto w-full max-w-[110rem] px-4 py-10 font-formal-sans text-real-text sm:px-6 lg:px-8'>
    <AdminHeader
      eyebrow='Fiction control'
      title='Manuscript management'
      description='Upload, title, order, and remove commission images stored outside the container.'
      active='commissions'
      viewHref='/fiction/commissions/'
      viewLabel='View works'
    />
    <div id='commission-notice' class='mb-5 hidden border px-4 py-3 text-sm' role='status' aria-live='polite'></div>
    <form id='commission-upload' class='grid items-end gap-4 border border-white/10 bg-real-surface p-5 md:grid-cols-[minmax(0,1fr)_10rem_minmax(15rem,1fr)_auto]'>
      <label class='grid gap-2'><span class='commission-label'>Public title</span><input name='title' required maxlength='240' class='commission-input' /></label>
      <label class='grid gap-2'><span class='commission-label'>Order</span><input name='displayOrder' required type='number' min='0' value='1000' class='commission-input' /></label>
      <label class='grid gap-2'><span class='commission-label'>Image</span><input name='file' required type='file' accept='image/png,image/jpeg,image/gif,image/webp' class='commission-input file:text-white' /></label>
      <button type='submit' class='bg-real-accent px-5 py-3 font-black text-black disabled:opacity-50'>Upload</button>
    </form>
    <div class='mt-6 flex items-center justify-between gap-4'><h2 class='text-xl font-black'>Uploaded works</h2><p id='commission-count' class='text-sm text-white/40'>Loading…</p></div>
    <div id='commission-list' class='mt-4 grid gap-5 sm:grid-cols-2 xl:grid-cols-3'></div>
  </main>
  <script>
    import '@/scripts/commission-admin';
  </script>
  <style is:global>
    .commission-input { @apply border border-white/20 bg-black/30 p-3 text-white outline-none transition focus:border-real-accent; }
    .commission-label { @apply text-xs font-bold uppercase tracking-[0.16em] text-white/60; }
  </style>
</Base>
