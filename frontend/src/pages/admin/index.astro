---
import Base from '@/templates/Base.astro';
---

<Base head={{ title: 'Administration | WeiKnight', description: 'Administration entrypoint' }} theme='real'>
  <main class='mx-auto grid min-h-[60vh] max-w-2xl place-items-center px-5 py-20 font-formal-sans text-real-text'>
    <section class='w-full border border-white/10 bg-real-surface p-8 text-center'>
      <p class='text-xs font-bold uppercase tracking-[.2em] text-real-accent'>Administration</p>
      <h1 class='mt-3 text-3xl font-black'>Opening blog management…</h1>
      <p class='mt-4 text-sm text-white/55'>If the page does not open automatically, use the link below.</p>
      <a href='/admin/blogs/' class='mt-6 inline-block border border-real-accent/40 px-5 py-3 font-bold text-real-accent'>Open administration</a>
    </section>
  </main>
  <script is:inline>location.replace('/admin/blogs/');</script>
</Base>
