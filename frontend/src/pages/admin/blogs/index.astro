---
import AdminHeader from '@/components/admin/AdminHeader.astro';
import Base from '@/templates/Base.astro';
---

<Base head={{ title: 'Blog Admin | WeiKnight', description: 'Blog administration' }} theme='real'>
  <main class='mx-auto w-full max-w-[110rem] px-4 py-10 font-formal-sans text-real-text sm:px-6 lg:px-8'>
    <section id='admin-panel'>
      <AdminHeader eyebrow='Content control' title='Blog editor' active='blogs' viewHref='/real/blog/' viewLabel='View blog' />

      <div id='notice' class='mb-5 hidden border px-4 py-3 text-sm' role='status' aria-live='polite'></div>

      <div class='grid min-h-[46rem] overflow-hidden border border-white/10 bg-black/20 lg:grid-cols-[21rem_minmax(0,1fr)]'>
        <aside class='flex min-h-0 flex-col border-b border-white/10 bg-black/25 lg:border-b-0 lg:border-r'>
          <div class='border-b border-white/10 p-4'>
            <div class='flex items-center justify-between gap-3'>
              <div>
                <h2 class='font-bold text-white'>Blogs</h2>
                <p id='post-count' class='mt-1 text-xs text-white/40'>Loading…</p>
              </div>
              <button id='new-post' type='button' class='bg-real-accent px-3 py-2 text-sm font-black text-black transition hover:bg-white'>+ New</button>
            </div>
            <label class='mt-4 block'>
              <span class='sr-only'>Search blogs</span>
              <input id='post-search' type='search' placeholder='Search title or slug…' autocomplete='off' class='input w-full text-sm' />
            </label>
          </div>
          <div id='posts-list' class='max-h-[25rem] min-h-48 overflow-y-auto p-2 lg:max-h-[calc(100vh-16rem)] lg:flex-1' aria-label='Blog list'></div>
        </aside>

        <section class='min-w-0'>
          <div id='empty-editor' class='flex min-h-[34rem] items-center justify-center p-8 text-center'>
            <div>
              <p class='text-5xl text-real-accent/40'>✎</p>
              <h2 class='mt-5 text-xl font-bold text-white'>Select a blog to edit</h2>
              <p class='mt-2 text-sm text-white/45'>Or create a new blog from the left panel.</p>
            </div>
          </div>

          <form id='post-form' class='hidden' novalidate>
            <input type='hidden' name='id' />
            <div class='sticky top-0 z-10 flex flex-wrap items-center justify-between gap-3 border-b border-white/10 bg-real-bg/95 px-5 py-4 backdrop-blur sm:px-7'>
              <div class='min-w-0'>
                <p id='editor-mode' class='text-xs font-bold uppercase tracking-[0.2em] text-real-accent'>Editing blog</p>
                <p id='save-state' class='mt-1 truncate text-xs text-white/45'>No unsaved changes</p>
              </div>
              <div class='flex flex-wrap items-center gap-2'>
                <a id='preview-post' href='#' target='_blank' class='hidden border border-white/20 px-4 py-2 text-sm text-white/70 transition hover:border-real-accent/50 hover:text-real-accent'>Preview ↗</a>
                <button id='delete-post' type='button' class='hidden border border-red-300/25 px-4 py-2 text-sm text-red-200 transition hover:bg-red-300/10'>Delete</button>
                <button id='save-post' type='submit' class='bg-real-accent px-5 py-2 text-sm font-black text-black transition hover:bg-white disabled:cursor-wait disabled:opacity-50'>Save blog</button>
              </div>
            </div>

            <div class='grid gap-5 p-5 sm:p-7'>
              <div class='grid items-start gap-5 xl:grid-cols-2'>
                <label class='grid gap-2'>
                  <span class='field-label'>Title</span>
                  <input name='title' required maxlength='200' placeholder='Blog title' class='input' />
                </label>
                <label class='grid gap-2'>
                  <span class='field-label'>URL slug</span>
                  <input name='slug' required maxlength='120' pattern='[a-z0-9]+(?:-[a-z0-9]+)*' placeholder='my-blog-post' class='input' />
                  <span class='text-xs text-white/35'>Lowercase letters, numbers and hyphens only.</span>
                </label>
              </div>

              <label class='grid gap-2'>
                <span class='field-label'>Summary</span>
                <textarea name='description' required maxlength='2000' placeholder='A short description shown in the blog list.' class='input min-h-24 resize-y'></textarea>
              </label>

              <div class='grid items-start gap-5 xl:grid-cols-2'>
                <label class='grid gap-2'>
                  <span class='field-label'>Publish date</span>
                  <input name='publishedAt' required type='datetime-local' class='input' />
                </label>
                <label class='grid gap-2'>
                  <span class='field-label'>Tags</span>
                  <input name='tags' placeholder='linux, docker, tutorial' class='input' />
                  <span class='text-xs text-white/35'>Separate multiple tags with commas.</span>
                </label>
              </div>

              <label class='grid gap-2'>
                <span class='flex flex-wrap items-end justify-between gap-2'>
                  <span class='field-label'>Markdown content</span>
                  <span id='content-count' class='text-xs font-normal normal-case tracking-normal text-white/35'>0 characters</span>
                </span>
                <textarea name='content' required spellcheck='true' placeholder='# Start writing…' class='input min-h-[32rem] resize-y font-real-mono text-base leading-7 [tab-size:2]'></textarea>
              </label>
            </div>
          </form>
        </section>
      </div>
    </section>
  </main>
  <script>
    import '@/scripts/blog-admin';
  </script>
  <style is:global>
    .input { @apply border border-white/20 bg-black/30 p-3 text-white outline-none transition placeholder:text-white placeholder:opacity-30 focus:border-real-accent; }
    .field-label { @apply text-xs font-bold uppercase tracking-[0.16em] text-white/60; }
  </style>
</Base>
