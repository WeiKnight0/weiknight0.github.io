---
import { sitePath } from '@/utils/paths.mjs';
import Base from '@/templates/Base.astro';
---

<Base head={{ title: 'Not found | WeiKnight', description: 'The requested page does not exist.' }} noindex>
  <main class='mx-auto grid min-h-[70vh] w-full max-w-4xl place-items-center px-6 py-20 text-center font-formal-sans'>
    <div>
      <p class='text-sm font-black uppercase tracking-[0.3em] text-real-accent'>404</p>
      <h1 class='mt-4 text-4xl font-black text-white sm:text-6xl'>Page not found</h1>
      <p class='mt-5 text-base text-white/50'>The requested page does not exist.</p>
      <a href={sitePath("/")} class='mt-8 inline-block border border-real-accent/40 px-5 py-3 font-bold text-real-accent transition hover:bg-real-accent/10'>Return home</a>
    </div>
  </main>
</Base>
