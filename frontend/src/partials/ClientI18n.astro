  const storageKey = 'site-locale';
  const getStoredLocale = () => localStorage.getItem(storageKey) === 'zh-cn' ? 'zh-cn' : 'en';

  const applyLocale = (locale: 'en' | 'zh-cn') => {
    const pathname = normalizePath(window.location.pathname);
    const page = pages[locale][pathname];
    const dictionary = i18n[locale];
    document.documentElement.lang = locale === 'zh-cn' ? 'zh-CN' : 'en';
    document.querySelectorAll<HTMLElement>('[data-language-current]')
      .forEach((element) => { element.textContent = localeLabels[locale]; });
    document.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach((link) => {
      if (link.dataset.targetLocale === locale) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
    if (page) {
      document.title = page.title;
      document.querySelector('meta[name="description"]')?.setAttribute('content', page.description);
    }

    document.querySelectorAll<HTMLElement>('[data-home-i18n], [data-page-i18n]').forEach((element) => {
      const key = element.dataset.pageI18n || element.dataset.homeI18n;
      if (!key) return;
      const value = page?.text[key as keyof typeof page.text] || dictionary.nav[key.replace('nav.', '') as keyof typeof dictionary.nav];
      if (value) element.textContent = value;
    });

    document.querySelectorAll<HTMLElement>('[data-footer-i18n]').forEach((element) => {
      const key = element.dataset.footerI18n as keyof typeof dictionary.footer | undefined;
      if (key && dictionary.footer[key]) element.textContent = dictionary.footer[key];
    });

    document.querySelectorAll<HTMLElement>('[data-home-link], [data-page-href]').forEach((element) => {
      const key = element.dataset.pageHref || element.dataset.homeLink;
      const href = key && page?.links[key as keyof typeof page.links];
      if (href) element.setAttribute('href', sitePath(href));
    });

    document.querySelectorAll<HTMLElement>('[data-localized-path]').forEach((element) => {
      const path = element.dataset.localizedPath;
      if (path) element.setAttribute('href', getLocalizedPath(path, locale));
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach((element) => {
      const target = element.dataset.targetLocale;
      if (target) element.href = getLanguagePath(pathname, target as 'en' | 'zh-cn');
    });
  };

  const setupClientI18n = () => {
    const pathname = normalizePath(window.location.pathname);
    const routeLocale = getLocaleFromPath(pathname);
    const localizedRoute = routeLocale === 'zh-cn';
    const locale = hasDistinctLocalePaths(pathname) ? routeLocale : getStoredLocale();
    if (localizedRoute) localStorage.setItem(storageKey, locale);
    applyLocale(locale);

    document.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach((link) => {
      if (link.dataset.clientI18nReady === 'true') return;
      link.dataset.clientI18nReady = 'true';
      link.addEventListener('click', (event) => {
        const target = link.dataset.targetLocale;
        if (!target) return;
        localStorage.setItem(storageKey, target);
        if (getLanguagePath(window.location.pathname, target as 'en' | 'zh-cn') !== sitePath(pathname)) return;
        event.preventDefault();
        applyLocale(target as 'en' | 'zh-cn');
      });
    });
  };

  setupClientI18n();
  document.addEventListener('astro:page-load', setupClientI18n);
</script>
