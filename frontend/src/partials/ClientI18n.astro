---
import { projectExperience as projects } from '@/utils/ProjectExperience';
const projectText = Object.fromEntries(['en', 'zh-cn'].map((locale) => [
  locale,
  Object.fromEntries(projects.flatMap((project) => {
    const content = project[locale as 'en' | 'zh-cn'];
    return [
      [`project.${project.id}.title`, content.title],
      [`project.${project.id}.description`, content.description],
      [`project.${project.id}.period`, content.period],
      [`project.${project.id}.role`, content.role],
      ...content.highlights.flatMap((highlight, index) => {
        const separator = locale === 'zh-cn' ? '：' : ': ';
        const boundary = highlight.indexOf(separator);
        return [
          [`project.${project.id}.highlight.${index}.label`, highlight.slice(0, boundary + separator.length)],
          [`project.${project.id}.highlight.${index}.body`, highlight.slice(boundary + separator.length)],
        ];
      }),
    ];
  })),
]));
---

<script type="application/json" id="project-translations" set:html={JSON.stringify(projectText).replaceAll('<', '\\u003c')} />

<script>
  import {
    getLanguagePath,
    getLocaleFromPath,
    getLocalizedPath,
    hasDistinctLocalePaths,
    i18n,
    localeLabels,
    normalizePath,
  } from '@/utils/i18n';

  import { sitePath } from '@/utils/paths.mjs';

  const pages: Record<'en' | 'zh-cn', Record<string, { title: string; description: string; text: Record<string, string>; links: Record<string, string> }>> = {
    en: {
      '/': {
        title: 'WeiKnight | Personal Site',
        description: 'Projects, notes, and worldbuilding theory by WeiKnight.',
        text: {
          'hero.greeting': 'Profile & experience',
          'hero.headline': 'Computer Science undergraduate at Southeast University · Class of 2027',
          'hero.description': 'I’m interested in how software systems work, and enjoy building applications—from web services to desktop tools.',
          'profile.locationValue': 'Nanjing, China',
          'education.heading': 'Education',
          'education.school': 'Southeast University',
          'education.period': 'Aug 2023–Jun 2027',
          'education.subject': 'Computer Science and Technology · Undergraduate',
          'education.description': 'Coursework includes data structures, algorithm design and analysis, computer networks, discrete mathematics, and artificial intelligence.',
          'skills.heading': 'Technical skills',
          'skills.languages': 'C/C++',
          'skills.languagesValue': 'Familiar with memory management, OOP, STL containers, and C++11 features.',
          'skills.linux': 'Linux & networking',
          'skills.linuxValue': 'Familiar with Linux development; understands sockets, I/O multiplexing, and epoll.',
          'skills.os': 'Operating systems',
          'skills.osValue': 'Familiar with IPC, synchronization, deadlocks, and memory management.',
          'skills.algorithms': 'Algorithms',
          'skills.algorithmsValue': 'Familiar with common data structures, sorting, greedy algorithms, and dynamic programming.',
          'skills.python': 'Python & deep learning',
          'skills.pythonValue': 'Familiar with PyTorch and NumPy; understands deep learning and D3QN/SACD fundamentals.',
          'skills.simulation': 'Network simulation',
          'skills.simulationValue': 'Familiar with OMNeT++ and INET-based network modeling and simulation.',
          'skills.engineering': 'Development tools',
          'skills.engineeringValue': 'Familiar with Git; experience with Docker, Nginx, and LaTeX.',
          'skills.english': 'English',
          'skills.englishValue': 'Good technical and academic reading comprehension; basic communication skills.',
          'projects.heading': 'Project Experience',
          'projects.all': 'More on GitHub ↗',
          'projects.source': 'Source ↗',
          'beyond.heading': 'Learning & creating',
          'notes.heading': 'Study notes ↗',
          'notes.description': 'An ongoing record of algorithms, operating systems, networks, computer architecture, and AI.',
          'notes.templates': 'Algorithm reference ↗',
          'creative.heading': 'Original worlds ↗',
          'creative.description': 'Outside of code, I build fictional worlds and explore the rules, histories, and characters within them.',
        },
        links: { home: '/' },
      },
    },
    'zh-cn': {
      '/': {
        title: 'WeiKnight | 个人主页',
        description: 'WeiKnight 的项目、笔记与世界观理论。',
        text: {
          'hero.greeting': '个人简介与经历',
          'hero.headline': '东南大学计算机科学与技术本科生 · 2027 届',
          'hero.description': '关注软件系统的原理与实现，也喜欢动手构建应用，从 Web 服务到桌面工具。',
          'profile.locationValue': '中国 · 南京',
          'education.heading': '教育背景',
          'education.school': '东南大学',
          'education.period': '2023.08–2027.06',
          'education.subject': '计算机科学与技术 · 本科在读',
          'education.description': '相关课程：数据结构、算法设计与分析、计算机网络、离散数学、人工智能概论。',
          'skills.heading': '专业技能',
          'skills.languages': 'C/C++',
          'skills.languagesValue': '熟悉内存管理、面向对象、STL 常用容器与 C++11 常用特性。',
          'skills.linux': 'Linux 与网络编程',
          'skills.linuxValue': '熟悉 Linux 开发，了解网络编程、IO 多路复用及 epoll 等机制。',
          'skills.os': '操作系统',
          'skills.osValue': '熟悉进程通信、同步互斥、死锁与内存管理等机制。',
          'skills.algorithms': '数据结构与算法',
          'skills.algorithmsValue': '熟悉链表、栈、队列、树及排序、贪心、动态规划等算法。',
          'skills.python': 'Python 与深度学习',
          'skills.pythonValue': '熟悉 Python、PyTorch、NumPy，了解深度学习及 D3QN、SACD 的基本原理。',
          'skills.simulation': '网络仿真',
          'skills.simulationValue': '熟悉 OMNeT++，具有基于 INET 的网络建模与仿真经验。',
          'skills.engineering': '开发工具',
          'skills.engineeringValue': '熟悉 Git，具有 Docker、Nginx 部署配置及 LaTeX 文档编写经验。',
          'skills.english': '英语能力',
          'skills.englishValue': '具备良好的技术文档与学术文献阅读能力，能够进行基本的英语交流。',
          'projects.heading': '项目经历',
          'projects.all': '更多 GitHub 项目 ↗',
          'projects.source': '源码 ↗',
          'beyond.heading': '学习与创作',
          'notes.heading': '学习笔记 ↗',
          'notes.description': '持续整理算法、操作系统、计算机网络、计算机组成与 AI 等方向的学习记录。',
          'notes.templates': '算法模板速查 ↗',
          'creative.heading': '原创世界 ↗',
          'creative.description': '代码之外，我也构建原创世界，探索其中的规则、历史，以及生活在里面的角色。',
        },
        links: { home: '/' },
      },
    },
  };

  const projectTranslations: Record<string, Record<string, string>> = JSON.parse(
    document.getElementById('project-translations')?.textContent ?? '{}'
  );
  for (const locale of ['en', 'zh-cn'] as const) {
    Object.assign(pages[locale]['/']!.text, projectTranslations[locale]);
  }

  const storageKey = 'site-locale';
  const getStoredLocale = () => localStorage.getItem(storageKey) === 'zh-cn' ? 'zh-cn' : 'en';

  const applyLocale = (locale: 'en' | 'zh-cn') => {
    const pathname = normalizePath(window.location.pathname);
    const page = pages[locale][pathname];
    const dictionary = i18n[locale];
    document.documentElement.lang = locale === 'zh-cn' ? 'zh-CN' : 'en';
    document.querySelectorAll<HTMLElement>('[data-language-current]')
      .forEach((element) => { element.textContent = localeLabels[locale]; });
    document.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach((link) => {
      if (link.dataset.targetLocale === locale) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
    if (page) {
      document.title = page.title;
      document.querySelector('meta[name="description"]')?.setAttribute('content', page.description);
    }

    document.querySelectorAll<HTMLElement>('[data-home-i18n], [data-page-i18n]').forEach((element) => {
      const key = element.dataset.pageI18n || element.dataset.homeI18n;
      if (!key) return;
      const value = page?.text[key as keyof typeof page.text] || dictionary.nav[key.replace('nav.', '') as keyof typeof dictionary.nav];
      if (value) element.textContent = value;
    });

    document.querySelectorAll<HTMLElement>('[data-footer-i18n]').forEach((element) => {
      const key = element.dataset.footerI18n as keyof typeof dictionary.footer | undefined;
      if (key && dictionary.footer[key]) element.textContent = dictionary.footer[key];
    });

    document.querySelectorAll<HTMLElement>('[data-home-link], [data-page-href]').forEach((element) => {
      const key = element.dataset.pageHref || element.dataset.homeLink;
      const href = key && page?.links[key as keyof typeof page.links];
      if (href) element.setAttribute('href', sitePath(href));
    });

    document.querySelectorAll<HTMLElement>('[data-localized-path]').forEach((element) => {
      const path = element.dataset.localizedPath;
      if (path) element.setAttribute('href', getLocalizedPath(path, locale));
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach((element) => {
      const target = element.dataset.targetLocale;
      if (target) element.href = getLanguagePath(pathname, target as 'en' | 'zh-cn');
    });
  };

  const setupClientI18n = () => {
    const pathname = normalizePath(window.location.pathname);
    const routeLocale = getLocaleFromPath(pathname);
    const localizedRoute = routeLocale === 'zh-cn';
    const locale = hasDistinctLocalePaths(pathname) ? routeLocale : getStoredLocale();
    if (localizedRoute) localStorage.setItem(storageKey, locale);
    applyLocale(locale);

    document.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach((link) => {
      if (link.dataset.clientI18nReady === 'true') return;
      link.dataset.clientI18nReady = 'true';
      link.addEventListener('click', (event) => {
        const target = link.dataset.targetLocale;
        if (!target) return;
        localStorage.setItem(storageKey, target);
        if (getLanguagePath(window.location.pathname, target as 'en' | 'zh-cn') !== sitePath(pathname)) return;
        event.preventDefault();
        applyLocale(target as 'en' | 'zh-cn');
      });
    });
  };

  setupClientI18n();
  document.addEventListener('astro:page-load', setupClientI18n);
</script>
